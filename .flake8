[flake8]
max-line-length = 120
extend-ignore = E203, E261, E302, E303, E305, E402, E501, E722, F401, F403, F405, F811, W291, W293, W391, W503
exclude =
    .git,
    __pycache__,
    backend/venv,
    venv,
    .venv,
    node_modules,
    scratch,
    scripts,
    archive,
    backend/scratch,
    backend/scripts,
    backend/alembic,
    backend/submissions,
    frontend
