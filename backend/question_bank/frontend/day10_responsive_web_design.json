    {
      "id": "Q-D10-001",
      "question": "What is responsive web design?",
      "options": {
        "A": "A design that adapts to different screen sizes",
        "B": "A design that works only on desktops",
        "C": "A design without CSS",
        "D": "A design using only images"
      },
      "correct_answer": "A"
    },
    {
      "id": "Q-D10-002",
      "question": "Which HTML element is commonly used to configure the viewport?",
      "options": {
        "A": "<meta>",
