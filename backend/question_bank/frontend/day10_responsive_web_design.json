      "question": "Which viewport meta tag is recommended for responsive pages?",
      "options": {
        "A": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
        "B": "<meta responsive=\"true\">",
        "C": "<viewport width=\"device\">",
        "D": "<meta screen=\"responsive\">"
